#!/bin/bash -l
#SBATCH --job-name=assonet
#SBATCH --output=test.out
#SBATCH --error=test.out
#SBATCH --account=r2207-203-users
#SBATCH --time=0:10:00
#SBATCH --mem-per-cpu=40GB
#SBATCH --partition=gpu
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=4
#SBATCH --gpus-per-node=4

# module purge
module load OpenMPI/4.0.5-NVHPC-21.2-CUDA-11.2.1

time mpirun apps/reprlearn/reprlearnmain apps/reprlearn/reprlearn.par
# mpirun apps/reprlearnspk/reprlearnspkmain apps/reprlearnspk/reprlearnspk.par
# python3 pytools/classifier.py

